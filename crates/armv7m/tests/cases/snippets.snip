# NAME | asm        (assembled standalone at address 0 by tests/tools/gen_cases.py; load at a 4-byte aligned address)
# Test memory map: counter A 0x20000100, counter B 0x20000104, log pointer 0x20000300 (log bytes from 0x20000310), capture block 0x20000400.
COUNT_LOOP | 1: adds r0, #1 ; b 1b
SPIN | 1: b 1b
SVC5_PROG | movs r0, #1 ; svc #5 ; movs r2, #2 ; 1: b 1b
UDF_PROG | movs r0, #1 ; udf #1 ; movs r0, #2 ; 1: b 1b
WFI_PROG | movs r0, #1 ; wfi ; movs r0, #2 ; 1: b 1b
WFI_THEN_COUNT | movs r0, #1 ; wfi ; 1: adds r0, #1 ; b 1b
H_COUNT_A | ldr r1, =0x20000100 ; ldr r2, [r1] ; adds r2, #1 ; str r2, [r1] ; bx lr
H_COUNT_B | ldr r1, =0x20000104 ; ldr r2, [r1] ; adds r2, #1 ; str r2, [r1] ; bx lr
H_LOG_1 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #1 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_LOG_2 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #2 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_LOG_3 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #3 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_LOG_4 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #4 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_LOG_5 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #5 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_LOG_6 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #6 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_A_PENDS_IRQ6 | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #1 ; strb r3, [r2], #1 ; str r2, [r1] ; ldr r0, =0xe000e200 ; movs r3, #64 ; str r3, [r0] ; ldr r2, [r1] ; movs r3, #2 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_A_PENDS_IRQ6_ISB | ldr r1, =0x20000300 ; ldr r2, [r1] ; movs r3, #1 ; strb r3, [r2], #1 ; str r2, [r1] ; ldr r0, =0xe000e200 ; movs r3, #64 ; str r3, [r0] ; isb ; ldr r2, [r1] ; movs r3, #2 ; strb r3, [r2], #1 ; str r2, [r1] ; bx lr
H_CAPTURE | ldr r1, =0x20000400 ; str sp, [r1] ; mov r2, lr ; str r2, [r1, #4] ; mrs r2, ipsr ; str r2, [r1, #8] ; mrs r2, control ; str r2, [r1, #12] ; bx lr
H_SVC_NUMBER | ldr r1, [sp, #24] ; ldrb r3, [r1, #-2] ; ldr r1, =0x20000400 ; str r3, [r1, #16] ; str sp, [r1] ; bx lr
H_SKIP_FAULTING_16BIT | ldr r1, [sp, #24] ; adds r1, #2 ; str r1, [sp, #24] ; ldr r1, =0x20000100 ; ldr r2, [r1] ; adds r2, #1 ; str r2, [r1] ; bx lr
H_BAD_RETURN | ldr r0, =0xfffffff5 ; bx r0
H_FAULT_IN_HANDLER | udf #9
FP_MAIN | vmov.f32 s0, #1.0 ; vmov.f32 s1, #2.0 ; vmov.f32 s16, #4.0 ; 1: adds r0, #1 ; b 1b
H_FP_TOUCH | vmov.f32 s0, #3.0 ; ldr r1, =0x20000100 ; ldr r2, [r1] ; adds r2, #1 ; str r2, [r1] ; bx lr
H_FP_CAPTURE | ldr r1, =0x20000400 ; mov r2, lr ; str r2, [r1, #4] ; mrs r2, control ; str r2, [r1, #12] ; ldr r2, =0xe000ef34 ; ldr r3, [r2] ; str r3, [r1, #16] ; ldr r3, [r2, #4] ; str r3, [r1, #20] ; bx lr
IDLE_LOOP | ldr r4, =0x20000100 ; ldr r7, =0x20000104 ; 1: ldr r5, =0x20000108 ; ldr r3, [r4] ; cbnz r3, 2f ; ldr r3, =0x2000010c ; ldr r3, [r3] ; cmp r3, #1 ; bls 1b ; 2: movs r0, #99 ; 3: b 3b
SYSTICK_SETUP | ldr r0, =0xe000e010 ; ldr r1, =999 ; str r1, [r0, #4] ; movs r1, #0 ; str r1, [r0, #8] ; movs r1, #7 ; str r1, [r0] ; 1: adds r5, #1 ; b 1b
MASK_THEN_UNMASK | cpsid i ; movs r0, #1 ; movs r0, #2 ; cpsie i ; movs r0, #3 ; movs r0, #4 ; 1: b 1b
LDREX_PROG | ldr r1, =0x20000100 ; ldrex r0, [r1] ; nop ; nop ; nop ; movs r3, #5 ; strex r2, r3, [r1] ; 1: b 1b
DWT_PROG | ldr r0, =0xe000edfc ; ldr r1, [r0] ; orr r1, r1, #0x1000000 ; str r1, [r0] ; ldr r0, =0xe0001000 ; movs r1, #1 ; str r1, [r0] ; ldr r2, [r0, #4] ; nop ; nop ; nop ; nop ; nop ; nop ; nop ; nop ; nop ; nop ; ldr r3, [r0, #4] ; 1: b 1b
PEND_PENDSV_NOPS_B | ldr r5, =0xe000ed04 ; movs r4, #1 ; lsls r4, r4, #28 ; str r4, [r5] ; nop ; nop ; b 1f ; 1: nop ; nop ; b 2f ; 2: b 2b
STORE_NOPS_B | str r1, [r0] ; nop ; nop ; b 1f ; 1: nop ; nop ; nop ; b 2f ; 2: b 2b
SEV_WFE | sev ; wfe ; movs r0, #1 ; wfe ; movs r0, #2 ; 1: b 1b
SYSTICK_READ_PROG | ldr r0, =0xe000e010 ; ldr r1, =79999 ; str r1, [r0, #4] ; movs r1, #0 ; str r1, [r0, #8] ; movs r1, #5 ; str r1, [r0] ; b 1f ; 1: nop ; nop ; nop ; nop ; nop ; ldr r2, [r0, #8] ; b 2f ; 2: b 2b
SYSTICK_READ_AFTER_BRANCH_PROG | ldr r0, =0xe000e010 ; ldr r1, =79999 ; str r1, [r0, #4] ; movs r1, #0 ; str r1, [r0, #8] ; movs r1, #5 ; str r1, [r0] ; b 1f ; 1: nop ; nop ; nop ; nop ; b 2f ; 2: ldr r2, [r0, #8] ; b 3f ; 3: b 3b
DWT_READ_PROG | ldr r0, =0xe0001000 ; movs r1, #1 ; str r1, [r0] ; b 1f ; 1: nop ; nop ; ldr r2, [r0, #4] ; b 2f ; 2: b 2b
FREERTOS_SYSTICK_INIT | ldr r0, =0xe000e010 ; movs r1, #0 ; str r1, [r0] ; str r1, [r0, #8] ; ldr r1, =79999 ; str r1, [r0, #4] ; movs r1, #7 ; str r1, [r0] ; b 1f ; 1: ldr r2, [r0] ; b 2f ; 2: b 2b
